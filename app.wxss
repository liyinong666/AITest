page {
  background: #f5f5f5;
  color: #1f2329;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC",
    "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

.container {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.desc,
.tip {
  display: block;
  color: #8a919f;
  line-height: 1.7;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  color: #8a919f;
}

.count {
  display: block;
  margin-bottom: 24rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #07c160;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 0 0 auto;
  margin: 0;
  padding: 0 40rpx;
  font-size: 28rpx;
  line-height: 76rpx;
  color: #1f2329;
  background: #f2f3f5;
  border-radius: 12rpx;
}

.btn::after {
  border: none;
}

.btn.primary {
  color: #ffffff;
  background: #07c160;
}

.btn.link {
  width: 100%;
  margin-top: 8rpx;
  color: #07c160;
  background: transparent;
  text-align: left;
}

.btn[disabled] {
  opacity: 0.5;
}
